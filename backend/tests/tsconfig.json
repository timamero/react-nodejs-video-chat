{
  "compilerOptions": {
    "lib": ["ES2021"],
    "module": "node16",
    "target": "ES2021",
    "rootDirs": ["./src"],
    "outDir": "dist",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "types": ["jest", "node"]
  },
  "exclude": ["./node_modules", "./tests"]
}
